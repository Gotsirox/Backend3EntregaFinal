{
  "openapi": "3.0.3",
  "info": {
    "title": "API Entrega Final - Módulo Users",
    "version": "1.0.0",
    "description": "Documentación Swagger del router /api/users del proyecto final de Backend III."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor local / contenedor Docker"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "Operaciones sobre usuarios"
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Obtener todos los usuarios",
        "description": "Devuelve el listado completo de usuarios almacenado en MongoDB.",
        "responses": {
          "200": {
            "description": "Listado de usuarios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "payload": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/users/{uid}": {
      "parameters": [
        {
          "in": "path",
          "name": "uid",
          "required": true,
          "description": "ID de MongoDB del usuario",
          "schema": {
            "type": "string",
            "example": "64b7f9c2e1a2b3c4d5e6f7a8"
          }
        }
      ],
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Obtener un usuario por ID",
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "payload": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Actualizar un usuario por ID",
        "description": "Actualiza los campos enviados en el body. Permite modificar first_name, last_name, email, password, role y pets.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              },
              "example": {
                "first_name": "Ana",
                "role": "admin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "User updated"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Eliminar un usuario por ID",
        "responses": {
          "200": {
            "description": "Usuario eliminado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "User deleted"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b7f9c2e1a2b3c4d5e6f7a8"
          },
          "first_name": {
            "type": "string",
            "example": "Ana"
          },
          "last_name": {
            "type": "string",
            "example": "Gómez"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@coderhouse.com"
          },
          "password": {
            "type": "string",
            "description": "Hash de la contraseña (bcrypt)",
            "example": "$2b$10$..."
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "example": "user"
          },
          "pets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "example": "64b7f9c2e1a2b3c4d5e6f7a9"
                }
              }
            }
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "example": "Ana"
          },
          "last_name": {
            "type": "string",
            "example": "Gómez"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@coderhouse.com"
          },
          "password": {
            "type": "string",
            "example": "coder123"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "example": "admin"
          },
          "pets": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "64b7f9c2e1a2b3c4d5e6f7a9"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "User not found"
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Recurso no encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "User not found"
            }
          }
        }
      },
      "InternalError": {
        "description": "Error interno del servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "message": "Internal Server Error"
            }
          }
        }
      }
    }
  }
}